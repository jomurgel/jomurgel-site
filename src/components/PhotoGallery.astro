---
// The /photos wall — grid of series covers. Each cover skews on hover
// (matching the post covers) with a centered title overlay; on touch the title
// sits under a bottom gradient instead. Covers are cropped to a square frame.
import { postUrl, coverThumb } from '../lib/words';

const { photos } = Astro.props;
---

<ul class="photo-gallery">
  {photos.map((p) => (
    <li class:list={['photo-item', { 'is-featured': p.data.featured }]}>
      <a href={postUrl(p)} aria-label={p.data.nsfw ? `${p.data.title} (NSFW)` : p.data.title}>
        <span class="photo-frame">
          <img class="photo-img" src={coverThumb(p.data.coverImage)} width="1000" height="1000" alt={p.data.coverAlt ?? p.data.title} loading="lazy" decoding="async" />
          {p.data.nsfw && <span class="nsfw-badge photo-badge" aria-hidden="true">NSFW</span>}
          <span class="photo-cap" aria-hidden="true">
            <span class="photo-cap-t">{p.data.title}</span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
