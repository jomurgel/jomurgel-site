---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import TagBand from '../../components/TagBand.astro';
import { getCollection } from 'astro:content';
import { getAllTags } from '../../lib/words';

const PAGE_SIZE = 6;
const all = (await getCollection('words', ({ data }) => !data.draft && data.type !== 'photo')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = all.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(all.length / PAGE_SIZE);
const tags = await getAllTags();
---

<Base title="Words" description="Writing by Jo Murgel — dev notes, reflections, and musings." heroInk="c">
  <PageHero
    ink="c"
    title="Words"
    lede="Dev notes, reflections, and whatever I'm thinking about lately."
  />

  <section>
    <PostList posts={posts} />
    <Pagination currentPage={1} totalPages={totalPages} />
    <p class="words-rss"><a href="/rss.xml">Subscribe via RSS</a></p>
  </section>

  {/* Outside the section: it's a fixed FAB, and the section's scroll-reveal
      transform would otherwise trap its position (below the content). */}
  <TagBand tags={tags} />
</Base>
