---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import PhotoArchive from '../../components/PhotoArchive.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../../lib/words';

const all = (await getCollection('words', ({ data }) => !data.draft && data.type === 'photo')).sort(byNewest);
// Featured/recent sets stay on the wall; archived sets drop into a compact list below.
const wall = all.filter((p) => !p.data.archive);
const archive = all.filter((p) => p.data.archive);
---

<Base
  title="Photos"
  description="Photography by Jo Murgel — nature, portraits, and art studies."
  heroInk="k"
  forceTheme="dark"
>
  <PageHero
    ink="k"
    title="Photos"
    lede="Series and studies — spanning my entire career from 2007 until now."
  />

  <section>
    <PhotoGallery photos={wall} />
  </section>

  {archive.length > 0 && (
    <section class="photo-archive-section" aria-labelledby="archive-heading">
      <h2 id="archive-heading" class="photo-archive-heading">Archive</h2>
      <PhotoArchive photos={archive} />
    </section>
  )}

  <div class="all-photos-cta">
    <a href="/photos/all/" class="all-photos-btn">All photos</a>
  </div>
</Base>
